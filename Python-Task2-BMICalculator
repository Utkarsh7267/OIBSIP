def get_positive_float(prompt):
    while True:
        raw = input(prompt).strip()
        try:
            value = float(raw)
        except ValueError:
            print(f"  Error: '{raw}' is not a valid number. Please enter a numeric value.")
            continue
        if value <= 0:
            print(f"  Error: value must be positive. You entered {value}.")
            continue
        return value


def classify_bmi(bmi):
    if bmi < 18.5:
        return "Underweight"
    elif bmi < 25:
        return "Normal"
    elif bmi < 30:
        return "Overweight"
    else:
        return "Obese"


def main():
    print("=== BMI Calculator ===")
    weight = get_positive_float("Enter your weight (kg): ")
    height = get_positive_float("Enter your height (m): ")

    bmi = weight / (height ** 2)
    category = classify_bmi(bmi)

    print("\n--- Result ---")
    print(f"BMI: {bmi:.2f}")
    print(f"Category: {category}")


if __name__ == "__main__":
    main()
