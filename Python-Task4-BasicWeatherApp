import os
import sys
import requests

# Recommended: Set your API key as an environment variable (export OPENWEATHER_API_KEY="your_key")
# Otherwise, replace the fallback string below.
API_KEY = os.getenv("OPENWEATHER_API_KEY", "YOUR_API_KEY_HERE")
BASE_URL = "https://api.openweathermap.org/data/2.5/weather"

def fetch_weather(location: str) -> dict | None:
    """Helper function to hit the OpenWeather API with basic error handling."""
    if not location or not location.strip():
        print("[!] Error: Location query cannot be empty.")
        return None

    params = {
        "q": location.strip(),
        "appid": API_KEY,
        "units": "metric"
    }

    try:
        response = requests.get(BASE_URL, params=params, timeout=8)
        
        if response.status_code == 404:
            print(f"[!] Location not found: '{location}'. Check spelling.")
            return None
        elif response.status_code == 401:
            print("[!] Authentication failed: Invalid API Key.")
            return None
            
        response.raise_for_status()
        return response.json()
        
    except requests.exceptions.Timeout:
        print("[!] Request timed out. Check your connection.")
    except requests.exceptions.RequestException as err:
        print(f"[!] Network error occurred: {err}")
        
    return None

def main():
    # Support both CLI arguments and interactive input
    if len(sys.argv) > 1:
        query = " ".join(sys.argv[1:])
    else:
        query = input("Enter city name or ZIP code: ")

    data = fetch_weather(query)
    if not data:
        sys.exit(1)

    # Extract required fields safely
    city = data.get("name", "Unknown")
    country = data.get("sys", {}).get("country", "")
    temp_c = data["main"]["temp"]
    temp_f = (temp_c * 9 / 5) + 32
    humidity = data["main"]["humidity"]
    condition = data["weather"][0]["description"].capitalize()
    wind_speed = data["wind"]["speed"]

    # Print clean formatted output
    print(f"\n[{city}, {country}]")
    print("-" * 25)
    print(f"• Weather : {condition}")
    print(f"• Temp    : {temp_c:.1f}°C / {temp_f:.1f}°F")
    print(f"• Humidity: {humidity}%")
    print(f"• Wind    : {wind_speed} m/s")
    print("-" * 25 + "\n")

if __name__ == "__main__":
    main()
